{
  "name": "betterman",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @betterman/db generate",
    "db:migrate": "pnpm --filter @betterman/db migrate",
    "db:deploy": "pnpm --filter @betterman/db deploy",
    "db:seed": "pnpm --filter @betterman/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "ingest:substack": "pnpm --filter @betterman/ingest ingest:substack",
    "ingest:email-dir": "pnpm --filter @betterman/ingest ingest:email-dir",
    "ingest:email-imap": "pnpm --filter @betterman/ingest ingest:email-imap"
  },
  "devDependencies": {
    "@betterman/config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.0.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.3"
  }
}
