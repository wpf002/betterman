{
  "name": "@betterman/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "ingest:substack": "tsx scripts/ingest-substack.ts",
    "ingest:email-dir": "tsx scripts/ingest-email-dir.ts",
    "ingest:email-imap": "tsx scripts/ingest-email-imap.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@betterman/db": "workspace:*",
    "cheerio": "1.0.0",
    "imapflow": "1.0.171",
    "mailparser": "3.7.1",
    "sanitize-html": "2.13.1"
  },
  "devDependencies": {
    "@betterman/config": "workspace:*",
    "@types/mailparser": "3.4.4",
    "@types/node": "22.7.5",
    "@types/sanitize-html": "2.13.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  }
}
