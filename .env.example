# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/betterman?schema=public"

# --- Redis ----------------------------------------------------------------
REDIS_URL="redis://localhost:6381"

# --- API ------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Shared secret the inbound-email webhook must present on POST /ingest/email
INGEST_EMAIL_SECRET="change-me"

# --- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Adobe Fonts kit serving neue-haas-grotesk-display / -text (sampled from betterman.com)
NEXT_PUBLIC_TYPEKIT_KIT_ID="sbo2xxd"

# --- Web Push (Phase 6) ---------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
# Same key, exposed to the browser so it can subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@betterman.com"

# --- BetterMornings mailbox backfill (pnpm ingest:email-imap) --------------
# The public site has no devotional archive, so history comes from the mailbox.
# For Gmail this must be an App Password, not the account password.
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"

# --- Outbound mail (password reset) ---------------------------------------
# "console" writes the message to the server log, including the link — enough
# to build and test the flow before choosing a provider. Switch to "resend"
# and set RESEND_API_KEY when one is picked.
MAIL_TRANSPORT="console"
MAIL_FROM="BetterMan Reader <no-reply@betterman.com>"
RESEND_API_KEY=""
# Absolute URL used in emailed links. Falls back to the request host.
NEXT_PUBLIC_APP_URL=""
